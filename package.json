{
  "name": "@amitkaps/markz",
  "version": "0.4.2",
  "description": "markz — small, opinionated Markdown.",
  "homepage": "https://markz.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/markz.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test --run",
    "size": "node test/size.ts",
    "fuzz": "SEARCH=${SEARCH:-50} SEED=${SEED:-random} vp test --run test/constructs.test.ts test/robustness.test.ts",
    "speed": "node test/speed.ts",
    "hotspots": "node test/speed.ts --profile",
    "compare": "node test/speed.ts --compare",
    "vendor": "node test/vendor.ts",
    "quality": "node test/quality/quality.ts",
    "prose": "prose",
    "verify": "pnpm check && pnpm prose check && pnpm test && pnpm build && pnpm size && pnpm prose build && pnpm quality && vp build",
    "ship": "cf deploy --prebuilt"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.7.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-67fa336fd",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.17",
    "fast-check": "^4.10.2",
    "github-slugger": "^2.0.0",
    "markdown-exit": "^1.3.0",
    "marked": "^18.1.1",
    "micromark": "^4.0.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "publint": "^0.3.25",
    "vite-plus": "1.2.0",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.13.0"
}
