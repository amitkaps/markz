{
  "name": "@amitkaps/markz",
  "version": "0.9.0",
  "description": "markz — small, opinionated Markdown.",
  "homepage": "https://markz.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/markz.git"
  },
  "bin": {
    "markz": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check && pnpm prose check && pnpm craftz check",
    "fix": "vp check --fix",
    "test": "vp test --run --project tests",
    "timing": "vp test --run --project timing",
    "size": "node test/size.ts",
    "fuzz": "SEARCH=${SEARCH:-50} SEED=${SEED:-random} vp test --run test/constructs.test.ts test/robustness.test.ts",
    "speed": "node test/speed.ts",
    "hotspots": "node test/speed.ts --profile",
    "compare": "node test/speed.ts --compare",
    "vendor": "node test/vendor.ts",
    "quality": "node test/quality/quality.ts",
    "site": "prose build",
    "prose": "prose",
    "verify": "vp run --log grouped all",
    "ship": "craftz deploy",
    "pr": "craftz pr",
    "gone": "craftz gone",
    "craftz": "craftz",
    "outline": "prose outline"
  },
  "devDependencies": {
    "@amitkaps/craftz": "0.13.0",
    "@amitkaps/prose": "0.11.0",
    "@types/node": "26.6.5",
    "fast-check": "^4.10.2",
    "github-slugger": "^2.0.0",
    "markdown-exit": "^1.3.0",
    "marked": "^18.1.2",
    "micromark": "^4.0.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "prettier": "^3.9.10",
    "publint": "0.3.25",
    "vite-plus": "1.4.0",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
