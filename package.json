{
	"name": "markz",
	"version": "0.0.1",
	"description": "markz — small, opinionated Markdown.",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vp pack --watch",
		"build": "vp pack",
		"check": "vp check",
		"test": "vp test --run",
		"prepublishOnly": "vp pack",
		"size": "node scripts/size.ts",
		"fuzz": "SEARCH=50 SEED=$RANDOM vp test --run test/constructs.test.ts test/robustness.test.ts",
		"bench": "pnpm --filter markz-bench bench",
		"bench:full": "pnpm --filter markz-bench bench:full",
		"bench:update-results": "pnpm --filter markz-bench update-results",
		"docs": "pnpm --filter markz-docs dev",
		"docs:build": "pnpm --filter markz-docs build"
	},
	"devDependencies": {
		"@amitkaps/prose": "https://github.com/amitkaps/prose/releases/download/v0.1.0/amitkaps-prose-0.1.0.tgz",
		"@types/node": "^26.0.0",
		"fast-check": "^4.10.2",
		"github-slugger": "^2.0.0",
		"micromark": "^4.0.3",
		"micromark-extension-directive": "^4.0.0",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"typescript": "^6.0.3",
		"vite-plus": "1.0.0-rc.0",
		"yaml": "^2.9.1"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.6.0"
}
