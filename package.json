{
  "name": "@amitkaps/markz",
  "version": "0.2.0",
  "description": "markz — small, opinionated Markdown.",
  "homepage": "https://markz.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/markz.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp pack",
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --run",
    "size": "node test/size.ts",
    "fuzz": "SEARCH=50 SEED=$RANDOM vp test --run test/constructs.test.ts test/robustness.test.ts",
    "bench": "node test/speed.ts",
    "vendor": "node test/vendor.ts",
    "quality": "node test/quality/quality.ts",
    "prose": "prose"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.3.0",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "github-slugger": "^2.0.0",
    "markdown-exit": "^1.3.0",
    "marked": "^18.0.14",
    "micromark": "^4.0.3",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
